# Copy to .env.local and fill in. None of these belong in client-side code.
#
# Provider: Resend (free tier — 3,000 emails/month, 100/day).
# Inbound uses Resend's managed <id>.resend.app address — NO DNS required.

# Resend API key (Dashboard -> API Keys). Starts with "re_".
RESEND_API_KEY=re_xxx

# Your Resend receiving subdomain (Dashboard -> Domains / Receiving).
# Looks like "abc123.resend.app". Replies are addressed to
# <conversationId>@<this domain>, which is how threading works. No DNS needed.
RESEND_INBOUND_DOMAIN=abc123.resend.app

# The identity outbound mail is sent FROM.
# Free tier without a verified domain: use onboarding@resend.dev (only delivers
# to your own Resend account email). Verify a domain to send to anyone.
RESEND_FROM_ADDRESS=onboarding@resend.dev

# Your deployed base URL (used for reference/config)
APP_BASE_URL=https://your-vercel-url.vercel.app

# Fallback notify address if the compose form's Notify field is left blank.
# Must be distinct from sender/receiver.
DEFAULT_NOTIFY_EMAIL=team@yourdomain.com

# Slack Incoming Webhook — every received reply (filtered or not) is POSTed
# here as a moderation alert. Create one at https://api.slack.com/apps ->
# your app -> Incoming Webhooks -> Add New Webhook to Workspace.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Upstash Redis (persistent store). Required so /api/send and the inbound
# webhook /api/inbound-email share the same data across serverless instances.
# Get both from the Upstash console -> your database -> "REST API" section,
# or add the Upstash Redis integration in Vercel to have them injected.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# OpenAI API key — powers the AI moderation checker (lib/moderation.ts) that
# flags curse words, abuse, and offensive slang beyond the offline dictionary.
# If left blank, moderation falls back to the offline dictionary only.
OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4o-mini).
OPENAI_MODERATION_MODEL=gpt-4o-mini
